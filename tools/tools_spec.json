                ]
              },
              "mensagem": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "consultar_historico_falhas": {
      "sucesso": {
        "type": "object",
        "required": [
          "ok",
          "tag",
          "janela",
          "total_registros",
          "registros"
        ],
        "properties": {
