            "required": [
              "tag",
              "tipo_ativo",
              "componente",
              "fabricante",
              "modelo",
              "km",
              "localizacao",
              "data_instalacao",
              "vida_util_anos",
              "impacto_seguranca",
              "impacto_arrecadacao",
              "criticidade",
              "redundancia",
              "origem"
            ],
            "properties": {
              "tag": {
                "type": "string"
              },
              "tipo_ativo": {
                "enum": [
                  "cftv_ptz",
                  "laco_indutivo",
                  "portico_free_flow"
                ]
              },
              "componente": {
                "type": "string"
              },
              "fabricante": {
                "type": "string"
              },
              "modelo": {
                "type": "string"
