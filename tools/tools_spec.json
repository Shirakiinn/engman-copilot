              }
            }
          }
        }
      },
      "erros": [
        {
          "codigo": "TAG_INVALIDA",
          "quando": "TAG fora do padrão dos 3 tipos cobertos",
          "comportamento_do_assistente": "Aplicar R6 ou R5 (se for outro tipo de ativo); pedir o TAG correto."
        },
        {
          "codigo": "ATIVO_NAO_ENCONTRADO",
          "quando": "TAG no padrão, mas ausente do catálogo",
          "comportamento_do_assistente": "Aplicar R6: 'Não encontrei esse dado na base.'; não sugerir TAG parecido."
        },
        {
          "codigo": "TIMEOUT",
          "quando": "Sem resposta em 10 s",
          "comportamento_do_assistente": "Repetir uma vez; se falhar, informar e não seguir com a priorização."
        }
      ],
      "formato_erro": {
